{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ESNext",
    "declarationDir": "./dist/types",
    "noEmit": false,  // Allow emission of .d.ts
    "emitDeclarationOnly": true,
    // "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "ts-node": {
    "transpileOnly": true,
    "swc": true
  },
  "include": ["src/**/*", "scripts/**/*"],
  "exclude": [
    "node_modules",
    "**/*.spec.ts",
    "tsconfig-paths-bootstrap.mjs",
    "src/proto/**/*",
    "dist",
    "config",
    "routes"
  ]
}
